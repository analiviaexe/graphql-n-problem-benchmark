{
  "name": "graphql-n-problem-benchmark",
  "type": "module",
  "scripts": {
    "compile": "tsc",
    "start": "npm run compile && node dist/server.js",
    "start:baseline": "npm run compile && RESOLVER_TYPE=baseline node dist/server.js",
    "start:dataloader": "npm run compile && RESOLVER_TYPE=dataloader node dist/server.js",
    "start:joinmonster": "npm run compile && RESOLVER_TYPE=joinmonster node dist/server.js",
    "db:import": "node --max-old-space-size=512 importer/import.js",
    "test:parity": "node benchmarks/validate-parity.js"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express4": "1.1.2",
    "@graphql-tools/schema": "10.1.5",
    "cors": "2.8.6",
    "dataloader": "2.2.3",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "graphql": "16.14.2",
    "join-monster": "4.0.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@apollo/protobufjs@1.2.8": true
  }
}
